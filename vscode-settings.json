{
  // ===== Editor =====
  "editor.fontFamily": "'Monaspace Neon', monospace",
  "editor.fontLigatures": "'calt', 'liga', 'dlig', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09'",
  "editor.formatOnSave": false,
  "editor.inlineSuggest.enabled": true,
  "editor.renderWhitespace": "all",
  "editor.tabSize": 2,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.multiCursorLimit": 100000,

  // ===== Files =====
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "node_modules": true,
    "vendor/bundle": true,
    "**/*.tsbuildinfo": true
  },

  // ===== Explorer =====
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // ===== Search =====
  "search.exclude": {
    "vendor/": true
  },

  // ===== Diff =====
  "diffEditor.ignoreTrimWhitespace": false,

  // ===== Terminal =====
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontFamily": "'Monaspace Neon', monospace",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontLigatures.featureSettings": "'calt', 'liga', 'dlig', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09'",
  "terminal.integrated.scrollback": 100000,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "terminal.integrated.initialHint": false,

  // ===== Workbench / Window =====
  "workbench.colorTheme": "Ayu Mirage",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.editor.empty.hint": "hidden",
  "window.confirmBeforeClose": "keyboardOnly",
  "workbench.colorCustomizations": {
    "terminal.background": "#282a36",
    "terminalCursor.background": "#282a36",
    "terminalCursor.foreground": "#97979b",
    "terminal.selectionBackground": "#97979b33",
    "terminal.foreground": "#eff0eb",
    "terminal.ansiBlack": "#282a36",
    "terminal.ansiRed": "#ff5c57",
    "terminal.ansiGreen": "#5af78e",
    "terminal.ansiYellow": "#f3f99d",
    "terminal.ansiBlue": "#57c7ff",
    "terminal.ansiMagenta": "#ff6ac1",
    "terminal.ansiCyan": "#9aedfe",
    "terminal.ansiWhite": "#f1f1f0",
    "terminal.ansiBrightBlack": "#686868",
    "terminal.ansiBrightRed": "#ff5c57",
    "terminal.ansiBrightGreen": "#5af78e",
    "terminal.ansiBrightYellow": "#f3f99d",
    "terminal.ansiBrightBlue": "#57c7ff",
    "terminal.ansiBrightMagenta": "#ff6ac1",
    "terminal.ansiBrightCyan": "#9aedfe",
    "terminal.ansiBrightWhite": "#eff0eb"
  },

  // ===== Languages =====
  "[ruby]": {
    "editor.defaultFormatter": "misogi.ruby-rubocop",
    "editor.codeActionsOnSave": {
      "editor.action.formatDocument": "explicit"
    }
  },
  "[html.erb]": {
    "editor.defaultFormatter": "manuelpuyol.erb-linter",
    "editor.formatOnSave": false
  },
  "[erb]": {
    "editor.defaultFormatter": "manuelpuyol.erb-linter",
    "editor.formatOnSave": false
  },
  "[javascript][typescript][typescriptreact][json]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": true
  },

  // ===== Rubocop =====
  "ruby.rubocop.useBundler": true,
  "erb.erb-lint.pathToBundler": "bin/bundle",

  // ===== ESLint =====
  "eslint.format.enable": true,
  "eslint.codeActionsOnSave.mode": "problems",
  "eslint.validate": [
    "javascript",
    "typescript",
    "typescriptreact",
    "json"
  ],
  "eslint.workingDirectories": [
    "app/assets/modules",
    "app/assets/preview_modules",
    "app/assets/types",
    "app/components",
    "test/components",
    "test/js",
    {
      "pattern": "./ui/packages/*/"
    }
  ],

  // ===== GitHub Copilot =====
  "github.copilot.enable": {
    "*": true,
    "yaml": false,
    "plaintext": false,
    "markdown": false,
    "html": false
  },
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.agent.thinkingTool": true,
  "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,

  // ===== GitHub Issues / Pull Requests =====
  "githubIssues.ignoreCompletionTrigger": [
    "python",
    "makefile",
    "ruby",
    "erb"
  ],
  "githubPullRequests.terminalLinksHandler": "github",
  "githubPullRequests.pullBranch": "never",

  // ===== Chat =====
  "chat.viewSessions.orientation": "stacked",
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://www.npmjs.com": true,
    "https://api.github.com": {
      "approveRequest": false,
      "approveResponse": true
    }
  },

  // ===== Remote =====
  "remote.autoForwardPortsSource": "hybrid",
  "remote.WSL.debug": true,

  // ===== Security =====
  "security.workspace.trust.untrustedFiles": "open"
}
