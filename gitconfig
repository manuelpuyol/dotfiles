[color]
  ui = auto
[core]
  commitGraph = true
  editor = vim
  excludesfile = ~/.gitignore
  quotepath = on
[credential]
  helper = dotfiles
[fetch]
  prune = true
  writeCommitGraph = true
[gc]
  writeCommitGraph = true
[protocol]
  version = 2
[push]
  default = simple
[tag]
  sort = -version:refname
[user]
  name = Manuel Puyol
  email = manuelpuyol@github.com
[pull]
	rebase = false
; Per-machine overrides (signing keys, work email, etc.). Optional; git
; silently ignores this include if the file does not exist.
[include]
  path = ~/.gitconfig.local
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
