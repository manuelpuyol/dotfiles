{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "playwright": {
      "command": "gh",
      "args": [
        "cfs",
        "--",
        "npx",
        "--yes",
        "--update-notifier=false",
        "--loglevel=error",
        "--package=@playwright/mcp@0.0.54",
        "--",
        "mcp-server-playwright"
      ]
    },
    "DataDog": {
      "type": "http",
      "url": "https://mcp.datadoghq.com/v1/mcp?toolsets=all",
      "headers": {},
      "tools": [
        "*"
      ],
      "source": "user"
    },
    "Sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp",
      "headers": {},
      "tools": [
        "*"
      ]
    },
    "Kusto": {
      "type": "local",
      "command": "gh",
      "args": [
        "cfs",
        "--",
        "npx",
        "--yes",
        "--update-notifier=false",
        "--loglevel=error",
        "--package=@azure/mcp@4.0.0-beta.5",
        "--",
        "azmcp",
        "server",
        "start"
      ],
      "tools": [
        "*"
      ],
      "source": "user"
    }
  }
}
