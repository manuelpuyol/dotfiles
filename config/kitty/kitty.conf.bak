# ~/.config/kitty/kitty.conf

include snazzy.conf

# Fonts

font_size 12.0
disable_ligatures never

# The font-monaspace cask installs the static faces (MonaspaceKrypton-*), not
# the variable (…Var-*) ones, so target the static PostScript names here.
# +calt/+liga give texthealing + ligatures; +dlig/+ssNN enable the coding sets.
# These must match the styles selected in the BEGIN_KITTY_FONTS block below
# (Light is the regular face, plus Bold / Italic / BoldItalic).
font_features MonaspaceKrypton-Light      +calt +liga +dlig +ss01 +ss02 +ss03 +ss04 +ss05 +ss06 +ss07 +ss08 +ss09
font_features MonaspaceKrypton-Bold       +calt +liga +dlig +ss01 +ss02 +ss03 +ss04 +ss05 +ss06 +ss07 +ss08 +ss09
font_features MonaspaceKrypton-Italic     +calt +liga +dlig +ss01 +ss02 +ss03 +ss04 +ss05 +ss06 +ss07 +ss08 +ss09
font_features MonaspaceKrypton-BoldItalic +calt +liga +dlig +ss01 +ss02 +ss03 +ss04 +ss05 +ss06 +ss07 +ss08 +ss09


# Window

window_padding_width 5
background_opacity 0.85

# Scrollback

scrollback_lines -1

# Behaviors

copy_on_select yes
open_url_modifiers cmd

# Mappings

# Open file in vscode

# map cmd+p kitten hints --type=linenum -- code -g {path}:{line}
map cmd+p kitten hints --customize-processing mega-hints.py

# MacOS

macos_quit_when_last_window_closed yes


# BEGIN_KITTY_FONTS
font_family      family="Monaspace Krypton"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
