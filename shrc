# Setup paths
remove_from_path() {
  [ -d "$1" ] || return
  PATHSUB=":$PATH:"
  PATHSUB=${PATHSUB//:$1:/:}
  PATHSUB=${PATHSUB#:}
  PATHSUB=${PATHSUB%:}
  export PATH="$PATHSUB"
}

add_to_path_start() {
  [ -d "$1" ] || return
  remove_from_path "$1"
  export PATH="$1:$PATH"
}

add_to_path_end() {
  [ -d "$1" ] || return
  remove_from_path "$1"
  export PATH="$PATH:$1"
}

force_add_to_path_start() {
  remove_from_path "$1"
  export PATH="$1:$PATH"
}

quiet_which() {
  command -v "$1" >/dev/null
}

add_to_path_start "/home/linuxbrew/.linuxbrew/bin"
add_to_path_start "/usr/local/bin"
add_to_path_start "/usr/local/sbin"

add_to_path_end "$HOME/.dotfiles/bin"

# Run rbenv if it exists
quiet_which rbenv && add_to_path_start "$(rbenv root)/shims"

# Node.js / nvm
export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"

# Load nvm without selecting a version yet (faster shell startup); load_nvmrc
# picks the right version per-directory below. Handles git- and brew-installed
# nvm on macOS and Linux.
if ! quiet_which nvm; then
  for nvm_sh in \
    "$NVM_DIR/nvm.sh" \
    "/opt/homebrew/opt/nvm/nvm.sh" \
    "/usr/local/opt/nvm/nvm.sh" \
    "/home/linuxbrew/.linuxbrew/opt/nvm/nvm.sh"
  do
    if [ -s "$nvm_sh" ]; then
      \. "$nvm_sh" --no-use
      break
    fi
  done
  unset nvm_sh
fi

# Put the default node version on PATH directly, without invoking nvm's slow
# resolver (`nvm use`/`nvm version` are ~1s cold). This keeps `node` available
# globally at ~0 startup cost; per-directory .nvmrc still overrides it via
# load_nvmrc on cd below.
nvm_activate_default() {
  [ -d "$NVM_DIR/versions/node" ] || return

  nvm_default_alias="$(cat "$NVM_DIR/alias/default" 2>/dev/null)"
  case "$nvm_default_alias" in
    v[0-9]*) nvm_default_bin="$NVM_DIR/versions/node/$nvm_default_alias/bin" ;;
    [0-9]*)  nvm_default_bin="$(command ls -d "$NVM_DIR"/versions/node/v"$nvm_default_alias"*/bin 2>/dev/null | sort -V | tail -1)" ;;
    *)       nvm_default_bin="$(command ls -d "$NVM_DIR"/versions/node/v*/bin 2>/dev/null | sort -V | tail -1)" ;;
  esac

  [ -n "$nvm_default_bin" ] && add_to_path_start "$nvm_default_bin"
  unset nvm_default_alias nvm_default_bin
}
quiet_which nvm && nvm_activate_default

# Switch Node.js version automatically based on the nearest .nvmrc.
# https://github.com/nvm-sh/nvm#calling-nvm-use-automatically-in-a-directory-with-a-nvmrc-file
load_nvmrc() {
  quiet_which nvm || return

  load_nvmrc_oldpwd="${1-}"
  load_nvmrc_path="$(nvm_find_nvmrc)"

  if [ -n "${load_nvmrc_path}" ]; then
    load_nvmrc_node_version="$(nvm version "$(cat "${load_nvmrc_path}")")"

    if [ "${load_nvmrc_node_version}" = "N/A" ]; then
      nvm install && hash -r
    elif [ "${load_nvmrc_node_version}" != "$(nvm version)" ]; then
      nvm use && hash -r
    fi
  elif [ -n "${load_nvmrc_oldpwd}" ] && [ -n "$(PWD="${load_nvmrc_oldpwd}" nvm_find_nvmrc)" ] && [ -n "${NVM_BIN-}" ]; then
    # Left an .nvmrc directory: drop that version and restore the default.
    nvm deactivate && hash -r
    nvm_activate_default
  fi

  unset load_nvmrc_oldpwd load_nvmrc_path load_nvmrc_node_version
}
